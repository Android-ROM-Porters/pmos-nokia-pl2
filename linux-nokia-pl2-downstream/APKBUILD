# Reference: https://postmarketos.org/vendorkernel
# Kernel config based on: arch/arm64/configs/

maintainer=""
pkgname=linux-nokia-pl2-downstream
pkgver=4.4.219
pkgrel=0

pkgdesc="HMD Global Nokia 6.1 (2018) downstream kernel"
arch="aarch64"
url="https://github.com/yesimxev/android_kernel_nokia_sdm660"
license="GPL-2.0-only"

# Kernel source
_repository="android_kernel_nokia_sdm660"
_commit="bbb19d7946e50720ccebd485c2f86f78f67adc22"

# Kernel architecture and packaging
_carch="arm64"
_flavor="${pkgname#linux-}"
_config="config-$_flavor.$arch"
_outdir="out"

makedepends="
	bash
	gcc-armv7
	bc
	bison
	devicepkg-dev
	elfutils-dev
	findutils
	flex
	linux-headers
	openssl-dev
	pahole
	perl
	python3
"

source="
	$pkgname-$_commit.tar.gz::https://github.com/yesimxev/$_repository/archive/$_commit.tar.gz
	$_config
"

builddir="$srcdir/$_repository-$_commit"

options="
	!check
	!strip
	!tracedeps
	pmb:cross-native
"

prepare() {
	default_prepare

	REPLACE_GCCH=0 . downstreamkernel_prepare
}

build() {
	unset LDFLAGS

	make O="$_outdir" ARCH="$_carch" CC="${CC:-gcc}" \\
		CROSS_COMPILE_ARM32="armv7-alpine-linux-musleabihf-" \\
		KBUILD_BUILD_VERSION="$((pkgrel + 1))-postmarketOS"
}

package() {
	downstreamkernel_package "$builddir" "$pkgdir" "$_carch" \
		"$_flavor" "$_outdir"
}

sha512sums="
