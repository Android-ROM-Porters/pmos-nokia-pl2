6f530318ea1d7fe5a93438dbb5e2f72ad36b290a132cf2c8029868dbd512d17aa41a67d33fc41f07079642a117c2bcd18cf6541c0a6650b7a6ffb5d4544aa238  config-nokia-pl2-downstream.aarch64
"
